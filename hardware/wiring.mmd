flowchart LR
    esp["ESP32 DevKit V1"]

    subgraph sensors["Cảm biến"]
        dht["DHT22 module"]
        mq["MQ-135 module<br/>AO"]
        divider["Chia áp<br/>20kΩ nối tiếp<br/>10kΩ xuống GND"]
    end

    subgraph outputs["Ngõ ra DC 5V"]
        relay["Relay 1 kênh<br/>cách ly quang"]
